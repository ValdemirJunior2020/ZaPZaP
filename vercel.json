{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/.netlify/functions/demo-chat",
      "destination": "/api/public?route=demo-chat"
    },
    {
      "source": "/.netlify/functions/public-config",
      "destination": "/api/public?route=public-config"
    },
    {
      "source": "/.netlify/functions/public-store",
      "destination": "/api/public?route=public-store"
    },
    {
      "source": "/.netlify/functions/widget-config",
      "destination": "/api/public?route=widget-config"
    },
    {
      "source": "/api/demo-chat",
      "destination": "/api/public?route=demo-chat"
    },
    {
      "source": "/api/public-config",
      "destination": "/api/public?route=public-config"
    },
    {
      "source": "/api/public-store",
      "destination": "/api/public?route=public-store"
    },
    {
      "source": "/api/widget-config",
      "destination": "/api/public?route=widget-config"
    },
    {
      "source": "/.netlify/functions/:function",
      "destination": "/api/:function"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/s/:slug",
      "destination": "/store.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self' https://*.supabase.co; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/widget-chat.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self'; img-src 'self' data: https:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; frame-ancestors https: http:; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(index.html|business.html|account.html|store.html)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://*.supabase.co; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/s/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
