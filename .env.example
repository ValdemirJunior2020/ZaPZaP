# Local-only ZaPZaP demo
PORT=8788
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# For a hosted NexusSales deployment, set these in Vercel Project Settings,
# not in source control. This file contains no real credentials.
NEXUS_SUPABASE_URL=
NEXUS_SUPABASE_PUBLISHABLE_KEY=
NEXUS_SUPABASE_SECRET_KEY=
NEXUS_ABUSE_SECRET=
NEXUS_OLLAMA_URL=
NEXUS_OLLAMA_GATEWAY_TOKEN=
NEXUS_OLLAMA_MODEL=qwen3:8b
NEXUS_LIVE_CHAT_ENABLED=true

# Enable only after verified PayPal Sandbox testing.
NEXUS_BILLING_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WIDGET_BUNDLE_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# WhatsApp optional: the retry trigger must be secured and scheduled separately.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CRON_SECRET=
