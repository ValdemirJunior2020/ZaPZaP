# Local-only ZaPZaP demo
PORT=8788
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# For a hosted NexusSales deployment, set these in Vercel Project Settings,
# not in source control. This file contains no real credentials.
NEXUS_SUPABASE_URL=
NEXUS_SUPABASE_PUBLISHABLE_KEY=
NEXUS_SUPABASE_SECRET_KEY=
NEXUS_ABUSE_SECRET=
NEXUS_OLLAMA_URL=
NEXUS_OLLAMA_GATEWAY_TOKEN=
NEXUS_OLLAMA_MODEL=qwen3:8b
# Free lighter local backup, attempted only if qwen3:8b fails.
NEXUS_OLLAMA_SECONDARY_ENABLED=true
NEXUS_OLLAMA_SECONDARY_MODEL=qwen3:4b
NEXUS_LIVE_CHAT_ENABLED=true

# Enable only after verified PayPal Sandbox testing.
NEXUS_BILLING_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WIDGET_BUNDLE_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# WhatsApp optional: the retry trigger must be secured and scheduled separately.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CRON_SECRET=

# Emergency OpenAI failover — OFF by default. Never commit real keys.
# Only customer chat and signed-in owner test chat can use this when Ollama fails.
NEXUS_OPENAI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
NEXUS_OPENAI_MODEL=gpt-4.1-mini
# Shared Supabase-backed daily call limits. NOT dollar hard caps.
NEXUS_OPENAI_DAILY_MAX_CALLS=50
NEXUS_OPENAI_TENANT_DAILY_MAX_CALLS=10
NEXUS_OPENAI_MAX_OUTPUT_TOKENS=250
