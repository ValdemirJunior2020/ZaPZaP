# COPY to .env.wa-local (ignored by Git). Never commit secrets.
# WA-AKG must run separately on your own Windows PC, default http://127.0.0.1:3790.
NEXUS_WA_AKG_URL=http://127.0.0.1:3790
# WA-AKG dashboard -> Settings -> API Keys; never share this key.
NEXUS_WA_AKG_API_KEY=
# OPTIONAL: set to existing linked session ID to reuse it after restarting the bridge.
NEXUS_WA_SESSION_ID=
# SAFETY: only these private test phone numbers may receive AI replies (international digits, no +).
NEXUS_WA_TEST_NUMBERS=
NEXUS_WA_BUSINESS_NAME=Nexus AI Demo Business
NEXUS_WA_OLLAMA_URL=http://127.0.0.1:11434
NEXUS_WA_OLLAMA_MODEL=qwen3:4b

# Reply scope: test (default) only approved sender numbers; all replies to ANY new incoming individual chat.
# Do NOT switch to all until you have verified Ollama replies and WhatsApp stability.
# Both modes ignore group chats, historical messages, and the connected account's own messages.
NEXUS_WA_REPLY_MODE=test
# Keep OFF if you want to require manual enable after business sync; ON otherwise.
NEXUS_WA_AUTO_REPLY=off
